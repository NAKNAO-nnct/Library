{
  "name": "library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{vue,css}\" --ignore-path .gitignore",
    "lint": "npm run lint:js && npm run lint:style",
    "lint:fix": "eslint . --fix",
    "data:import": "node scripts/import-library.mjs",
    "predev": "npm run data:import",
    "prebuild": "npm run data:import",
    "pregenerate": "npm run data:import",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=12.2.1 <13"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.21.0",
    "js-cookie": "^3.0.8",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44",
    "vuetify": "^4.3.1",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.13.0",
    "postcss-html": "^1.8.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "fflate": "^0.8.3"
  },
  "volta": {
    "node": "24.22.2",
    "npm": "12.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
